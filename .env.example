# HydroQuote AI - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================
# IBM Watson NLU (health check / legacy)
# ============================================
WATSON_NLU_API_KEY=your_watson_nlu_api_key_here
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ============================================
# IBM watsonx.ai — tried FIRST for inquiry LLM
# ============================================
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-13b-chat-v2

# ============================================
# OpenAI (ChatGPT) — tried SECOND if IBM fails
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# DeepSeek — tried THIRD if ChatGPT fails
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Fallback order (comma-separated): ibm -> openai -> deepseek
LLM_FALLBACK_ORDER=ibm,openai,deepseek

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_NAME=HydroQuote AI
APP_VERSION=2.0.0
LOG_LEVEL=INFO
API_PORT=8000

# ============================================
# API Security (Optional)
# ============================================
# API_KEY=your_secure_api_key_here
# API_KEY_NAME=X-API-Key

# ============================================
# CORS Configuration (Optional)
# ============================================
CORS_ORIGINS=*

# ============================================
# Feature Flags
# ============================================
ENABLE_PI_DOWNLOAD=true
ENABLE_FILE_LOGGING=false
ENABLE_SWAGGER_DOCS=true

# ============================================
# LLM Generation Parameters
# ============================================
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_TOP_P=1.0

# ============================================
# File Storage (Optional)
# ============================================
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# ============================================
# HydroQuote v2 — LangGraph / MCP / Swarm
# ============================================
HYDROQUOTE_TOKENS=devtoken:tenant-demo:customer,revtoken:tenant-demo:reviewer,swarmtoken:tenant-demo:swarm
HYDROQUOTE_DEFAULT_TOKEN=devtoken
HYDROQUOTE_SWARM_ENABLED=false
